---
import Base from "@/layouts/Base.astro";
import { experience } from "@/data/experience";
---

<Base
  title="Experience"
  description="10+ years of mobile and full-stack engineering — React Native, TypeScript, Expo. Full work history for Nicolas Zilli."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24">

    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-zinc-100">Experience</h1>
      <p class="mt-3 text-zinc-500 dark:text-zinc-400">
        10+ years building mobile and web products end-to-end.
      </p>
    </div>

    <div class="space-y-12">
      {experience.map((exp) => (
        <div>
          <div class="mb-5">
            <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">{exp.company}</h2>
            {exp.context && (
              <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5 italic">{exp.context}</p>
            )}
          </div>

          <div class="space-y-8 pl-4 border-l-2 border-zinc-200 dark:border-zinc-700">
            {exp.roles.map((role) => (
              <div class="relative pl-5">
                <div class="absolute -left-[1.3rem] top-1.5 w-2.5 h-2.5 rounded-full bg-teal-500 dark:bg-teal-400 ring-2 ring-white dark:ring-zinc-950" />

                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                  <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">{role.title}</h3>
                  <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400 shrink-0">
                    <span>{role.period}</span>
                    <span>·</span>
                    <span>{role.location}</span>
                  </div>
                </div>

                <ul class="space-y-1.5 mb-4">
                  {role.highlights.map((h) => (
                    <li class="flex gap-2 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
                      <span class="text-zinc-400 dark:text-zinc-500 mt-0.5 shrink-0">—</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-1.5">
                  {role.stack.map((tech) => (
                    <span class="text-xs text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 rounded font-mono">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Education -->
    <div class="mt-16 pt-10 border-t border-zinc-200 dark:border-zinc-800">
      <h2 class="text-xs font-semibold tracking-widest uppercase text-zinc-400 dark:text-zinc-500 mb-6">
        Education
      </h2>
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:justify-between">
          <div>
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">M.Eng. Computer Science</p>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">Polytech Lyon</p>
          </div>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 sm:mt-0">2011 – 2014</p>
        </div>
        <div class="flex flex-col sm:flex-row sm:justify-between">
          <div>
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">DUT Informatique</p>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">IUT Lyon 1</p>
          </div>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 sm:mt-0">2009 – 2011</p>
        </div>
      </div>
    </div>

    <!-- Resume download -->
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/nicolas_zilli_resume_en.pdf"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download resume (EN)
      </a>
      <a
        href="/nicolas_zilli_cv_fr.pdf"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Télécharger le CV (FR)
      </a>
    </div>

  </div>
</Base>
