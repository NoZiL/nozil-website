---
import Base from "@/layouts/Base.astro";
import { skills } from "@/data/skills";
---

<Base title="Nicolas Zilli">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24">

    <!-- Hero -->
    <section>
      <p class="text-sm font-medium text-teal-600 dark:text-teal-400 mb-3 tracking-wide uppercase">
        Available for hire · Lyon, France · Remote-friendly
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold text-zinc-900 dark:text-zinc-100 leading-tight">
        Nicolas Zilli
      </h1>
      <p class="mt-3 text-xl text-zinc-500 dark:text-zinc-400 font-medium">
        Product-Minded Senior Engineer · React Native · 10+ yrs
      </p>
      <p class="mt-6 text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl">
        Staff-level mobile engineer with 10+ years owning products end-to-end — greenfield to production,
        sole IC to team lead. Deep expertise in React Native and TypeScript across the full stack.
        Track record of driving system-level decisions: architecture, auth migrations, CI/CD pipelines,
        design systems, and scaling mobile products from 0 to paying customers.
      </p>
      <p class="mt-4 text-base text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-2xl">
        Open to freelance contracts (React Native, full-stack mobile/web) and staff or founding engineer
        roles in ambitious product companies.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex items-center px-5 py-2.5 rounded-lg bg-teal-600 text-white text-sm font-semibold hover:bg-teal-500 transition-colors"
        >
          Get in touch
        </a>
        <a
          href="/experience"
          class="inline-flex items-center px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-semibold hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
        >
          View experience
        </a>
        <a
          href="/nicolas_zilli_resume_en.pdf"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-semibold hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Resume (EN)
        </a>
        <a
          href="/nicolas_zilli_cv_fr.pdf"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-semibold hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          CV (FR)
        </a>
      </div>

      <div class="mt-8 flex items-center gap-5">
        <a
          href="https://github.com/nozil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-100 transition-colors"
          aria-label="GitHub"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/nicolaszilli/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-100 transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Skills -->
    <section class="mt-20">
      <h2 class="text-xs font-semibold tracking-widest uppercase text-zinc-400 dark:text-zinc-500 mb-6">
        Skills
      </h2>
      <div class="space-y-4">
        {skills.map((group) => (
          <div class="flex flex-col sm:flex-row sm:gap-6">
            <span class="text-sm font-medium text-zinc-500 dark:text-zinc-400 sm:w-36 shrink-0 mb-1 sm:mb-0 sm:pt-0.5">
              {group.label}
            </span>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="text-sm text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded-md">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Recent highlight -->
    <section class="mt-20 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
      <p class="text-xs font-semibold tracking-widest uppercase text-zinc-400 dark:text-zinc-500 mb-3">
        Currently
      </p>
      <p class="text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
        Lead Mobile Engineer at <strong class="text-zinc-900 dark:text-zinc-100">Tennaxia</strong> (Lyon) —
        bootstrapped their mobile team from zero, shipped a B2B EHS field app integrating the French
        government's Trackdéchets waste-tracing platform, and scaled the team to 3.5 engineers.
      </p>
      <a href="/experience" class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-teal-600 dark:text-teal-400 hover:text-teal-500 transition-colors">
        Full experience
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

  </div>
</Base>
